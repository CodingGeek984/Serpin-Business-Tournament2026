# Rename to .env or export these variables before starting the API.
# Download this key in Firebase Console → Project settings → Service accounts.
FIREBASE_SERVICE_ACCOUNT=/absolute/path/to/service-account.json
FIREBASE_PROJECT_ID=your-firebase-project-id
JWT_SECRET_KEY=replace-with-a-long-random-production-secret
VITE_GEMINI_API_KEY=your-gemini-api-key